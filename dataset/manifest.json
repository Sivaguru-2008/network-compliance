  "framework_sources": {
    "description": "Classification of how each framework's control references were sourced. VERIFIED_FROM_PDF means clause numbers were checked against an authoritative PDF. CONTROL_INTENT means the rule captures the security intent of the benchmark but clause numbers are not asserted. GENERIC_MAPPING means no official benchmark exists for this vendor; rules are derived from generic hardening best practices.",
    "classifications": {
      "VERIFIED_FROM_PDF": "Clause numbers verified against a licensed/published copy of the benchmark PDF.",
      "CONTROL_INTENT": "Security intent follows the benchmark; exact clause numbers not asserted.",
      "GENERIC_MAPPING": "No official benchmark exists for this vendor; mapped from generic hardening best practices."
    },
    "vendors": {
      "cisco_ios": "VERIFIED_FROM_PDF",
      "fortinet_fortios": "VERIFIED_FROM_PDF",
      "paloalto": "CONTROL_INTENT",
      "juniper_junos": "CONTROL_INTENT",
      "arista_eos": "CONTROL_INTENT",
      "sonic_sonic": "CONTROL_INTENT",
      "huawei_vrp": "CONTROL_INTENT",
      "checkpoint_gaia": "CONTROL_INTENT",
      "mikrotik_routeros": "GENERIC_MAPPING",
      "sonicwall": "GENERIC_MAPPING",
      "stormshield_sns": "GENERIC_MAPPING",
      "watchguard_fireware": "GENERIC_MAPPING"
    }
  }
