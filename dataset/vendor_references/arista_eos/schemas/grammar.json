{
  "vendor_key": "arista_eos",
  "vendor_name": "Arista",
  "os_name": "Arista EOS",
  "syntax_type": "cisco_hierarchical",
  "root_blocks": [
    {
      "block_name": "global_config",
      "entry_keyword": "",
      "exit_keyword": null,
      "child_delimiter": " ",
      "statement_terminator": "\n",
      "allowed_subblocks": [
        "management ssh",
        "management api http-commands",
        "interface",
        "aaa"
      ],
      "common_directives": [
        "hostname",
        "enable secret",
        "logging host",
        "ntp server"
      ],
      "security_directives": [
        "no management api http-commands",
        "management ssh server shutdown",
        "logging level",
        "banner login"
      ]
    }
  ],
  "negation_prefix": "no",
  "comment_prefixes": [
    "!",
    "#"
  ],
  "indentation_sensitive": true,
  "schema_definition": {
    "format": "eos_cli_hierarchy"
  }
}